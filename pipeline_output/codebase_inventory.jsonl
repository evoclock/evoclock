{"path": "scripts/codebase_inventory.py", "subdir": "scripts", "filename": "codebase_inventory.py", "blob_sha": "028595674dbfa1e474ed3ad00437552bf30ca672", "loc": 391, "size_bytes": 14057, "language": "python", "imports": ["__future__.annotations", "argparse", "ast", "hashlib", "json", "re", "subprocess", "sys", "tempfile", "collections.Counter", "pathlib.Path", "typing.Any"], "constants": [{"name": "SHELL_FUNC_RE", "value": "<call re.compile(...)>"}, {"name": "SHELL_VAR_RE", "value": "<call re.compile(...)>"}, {"name": "IDENT_RE", "value": "<call re.compile(...)>"}, {"name": "DEFAULT_INCLUDE_DIRS", "value": "<list len=3>"}, {"name": "CONFIG_FILE", "value": "'.codebase-inventory'"}], "functions": [{"name": "configured_include_dirs", "loc": 11, "complexity": 6, "public": true, "refcount": 1, "args": [{"name": "source_root", "annotation": "Path"}], "returns": "list[str]", "decorators": [], "docstring": "Read repository-owned scan roots, or use the portable defaults."}, {"name": "_git_blob_sha", "loc": 4, "complexity": 1, "public": false, "refcount": 1, "args": [{"name": "data", "annotation": "bytes"}], "returns": "str", "decorators": [], "docstring": "The git blob sha of file bytes (== git hash-object), computed in-process so a\nrecord can be checked against `git rev-parse <commit>:<path>` for drift."}, {"name": "_shebang_kind", "loc": 14, "complexity": 7, "public": false, "refcount": 1, "args": [{"name": "path", "annotation": "Path"}], "returns": "str | None", "decorators": [], "docstring": "For an extensionless file: 'python' or 'shell' inferred from its #! line, else\nNone. This is what makes an extensionless main script visible to the inventory."}, {"name": "_complexity", "loc": 28, "complexity": 7, "public": false, "refcount": 1, "args": [{"name": "node", "annotation": "ast.AST"}], "returns": "int", "decorators": [], "docstring": "Cyclomatic complexity: 1 plus the branch points within the node. A simple\nbranch count, deliberately not a full control-flow analysis (anti-bloat)."}, {"name": "_loc", "loc": 4, "complexity": 3, "public": false, "refcount": 2, "args": [{"name": "node", "annotation": "ast.AST"}], "returns": "int | None", "decorators": [], "docstring": null}, {"name": "extract_python", "loc": 69, "complexity": 23, "public": true, "refcount": 1, "args": [{"name": "path", "annotation": "Path"}], "returns": "dict[str, Any]", "decorators": [], "docstring": null}, {"name": "_extract_function", "loc": 16, "complexity": 5, "public": false, "refcount": 2, "args": [{"name": "node", "annotation": "ast.FunctionDef | ast.AsyncFunctionDef"}], "returns": "dict[str, Any]", "decorators": [], "docstring": null}, {"name": "_name_of", "loc": 5, "complexity": 2, "public": false, "refcount": 3, "args": [{"name": "node", "annotation": "ast.AST"}], "returns": "str", "decorators": [], "docstring": null}, {"name": "_summarize_value", "loc": 10, "complexity": 5, "public": false, "refcount": 2, "args": [{"name": "node", "annotation": "ast.AST"}], "returns": "str", "decorators": [], "docstring": null}, {"name": "extract_shell", "loc": 21, "complexity": 8, "public": true, "refcount": 1, "args": [{"name": "path", "annotation": "Path"}], "returns": "dict[str, Any]", "decorators": [], "docstring": null}, {"name": "_kind_of", "loc": 11, "complexity": 4, "public": false, "refcount": 1, "args": [{"name": "path", "annotation": "Path"}], "returns": "str | None", "decorators": [], "docstring": "Which extractor (if any) handles this file: by suffix, or by shebang when the\nfile is extensionless."}, {"name": "main", "loc": 113, "complexity": 27, "public": true, "refcount": 12, "args": [], "returns": "int", "decorators": [], "docstring": null}], "classes": [], "module_docstring": "Walk a repo and emit a structured inventory of its code.\n\nFor each Python file under the scanned directories: module docstring, top-level\nimports, top-level constants/assignments, function and class signatures (with\ntheir docstrings) — all extracted via ast, no execution. For each shell file:\nheader comments, function names, uppercase variable assignments — via regex.\nExtensionless files whose first line is a python/bash shebang are covered too,\nso a main script with no extension is not invisible to prior-art lookups.\n\nEach record carries cheap signals up front: blob_sha (== git hash-object, so a\nrecord is checkable against a commit), loc, and per function/class\nloc, complexity, public, and refcount (in-repo references minus the definition —\na single-use function is a smell). Short scalar fields come first and the long\nfields (docstrings, imports, signatures) last, so a record line scans easily.\n\nPurpose: give an agent or a developer a cheap lookup of \"what already exists in\nthis repo\" before writing new code. One JSONL record per file.\n\nDefaults:\n    --source-root  : cwd\n    --include-dirs : scripts workflows src\n    --output       : <source-root>/pipeline_output/codebase_inventory.jsonl\n\nMissing include-dirs are skipped silently. Output directory is created if\nabsent. Hidden dirs and __pycache__ are always skipped.\n\nUsage:\n    python scripts/codebase_inventory.py\n    python scripts/codebase_inventory.py --include-dirs scripts tests\n    python scripts/codebase_inventory.py --source-root /path/to/repo"}
